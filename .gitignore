claude/
.cis-build/
__pycache__/

# Benchmark source documents. The CIS terms of use forbid redistributing the
# benchmark PDFs, and CIS-CAT / Policy Analyzer reports describe real hosts.
# A file that is already tracked stays tracked - see sources/README.md.
sources/*
!sources/README.md

# Audit reports the engine writes next to itself (they contain host data).
# Covers the current Windows_Hardening_Audit_* name and the older Win11_ one.
*_Hardening_Audit_*.xlsx
*_Hardening_Audit_*.csv
